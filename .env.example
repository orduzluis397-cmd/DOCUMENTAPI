# =====================================================================
# Contable IA — variables de entorno (plantilla)
# Copia este archivo a `.env` y completa los valores. `.env` NUNCA se sube.
# Ningún valor de aquí es un secreto real: los "change-me" deben reemplazarse.
# =====================================================================

# ---------------- Aplicación ----------------
APP_NAME="Contable IA API"
APP_ENV=local                      # local | test | staging | production
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
SECRET_KEY=change-me               # firma de sesiones/tokens internos

# ---------------- PostgreSQL (pgvector) ----------------
POSTGRES_USER=contable
POSTGRES_PASSWORD=change-me
POSTGRES_DB=contable_ia
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://contable:change-me@localhost:5432/contable_ia
DATABASE_URL_TEST=postgresql+psycopg://contable:change-me@localhost:5432/contable_ia_test

# ---------------- Redis / Celery ----------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------------- Almacenamiento de objetos (MinIO local / R2 / S3) ----------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=contable-ia-documents
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change-me

# ---------------- Proveedores LLM ----------------
# Tope de gasto mensual configurado en cada proveedor (INSTRUCCIONES.md §3).
LLM_PROVIDER=anthropic             # proveedor principal
LLM_MODEL_EXTRACTION=
LLM_MODEL_JUDGE=
LLM_TEMPERATURE_EXTRACTION=0
ANTHROPIC_API_KEY=
OPENAI_API_KEY=                    # segundo proveedor para comparar
LLM_MONTHLY_BUDGET_USD=40
LLM_DAILY_BUDGET_USD=2

# ---------------- Modelo propio (fase 4, vLLM compatible OpenAI) ----------------
VLLM_BASE_URL=
VLLM_API_KEY=
VLLM_MODEL=

# ---------------- Embeddings y re-ranker (fase 2) ----------------
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIM=
RERANKER_MODEL=

# ---------------- Observabilidad ----------------
# Langfuse Cloud (o Phoenix local con: docker compose --profile observability up -d)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
PHOENIX_PORT=6006
PHOENIX_OTLP_GRPC_PORT=4317
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# ---------------- MLflow (fase 2) ----------------
MLFLOW_TRACKING_URI=
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
MLFLOW_ARTIFACT_BUCKET=contable-ia-mlflow

# ---------------- Autenticación (Clerk o Auth.js) ----------------
AUTH_PROVIDER=                     # clerk | authjs
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
AUTH_SECRET=

# ---------------- Web (Next.js) ----------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------- Servidor MCP (fase 3) ----------------
MCP_SERVER_PORT=8765

# ---------------- Anonimización (solo local) ----------------
# Clave para cifrar la tabla de correspondencias de ml/anonymize.py. Nunca fuera de la máquina local.
ANONYMIZATION_MAPPING_KEY=
