# =====================================================================
# Contable IA — variables de entorno (plantilla)
# Copia este archivo a `.env` y completa los valores. `.env` NUNCA se sube.
# Ningún valor de aquí es un secreto real: los "change-me" deben reemplazarse.
# Las credenciales "*_local" de Postgres y MinIO son solo para desarrollo local y coinciden con
# los valores por defecto de infra/docker-compose.yml (si las cambias, levanta compose con
# --env-file .env). Nunca las uses fuera de tu máquina.
# Los servicios de compose escuchan solo en 127.0.0.1 (IPv4): usa 127.0.0.1 y no localhost en las
# URLs de servicios, porque localhost puede resolver primero a ::1 y la conexión se cuelga.
# =====================================================================

# ---------------- Aplicación ----------------
APP_NAME="Contable IA API"
APP_ENV=local                      # local | test | staging | production
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_HOST=127.0.0.1                 # solo local; en contenedor/producción, 0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
SECRET_KEY=change-me               # firma de sesiones/tokens internos

# ---------------- PostgreSQL (pgvector) ----------------
# contable: dueño del esquema, solo para migraciones (Alembic).
# contable_app: rol de la aplicación (sin superusuario ni BYPASSRLS: RLS siempre aplica).
POSTGRES_USER=contable
POSTGRES_PASSWORD=contable_local
POSTGRES_DB=contable_ia
POSTGRES_APP_USER=contable_app
POSTGRES_APP_PASSWORD=contable_app_local
POSTGRES_TEST_DB=contable_ia_test
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://contable_app:contable_app_local@127.0.0.1:5432/contable_ia
DATABASE_URL_MIGRATIONS=postgresql+psycopg://contable:contable_local@127.0.0.1:5432/contable_ia
DATABASE_URL_TEST=postgresql+psycopg://contable_app:contable_app_local@127.0.0.1:5432/contable_ia_test
DATABASE_URL_TEST_MIGRATIONS=postgresql+psycopg://contable:contable_local@127.0.0.1:5432/contable_ia_test

# ---------------- Redis / Celery ----------------
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
CELERY_TASK_ALWAYS_EAGER=false     # true solo en pruebas (tareas en el mismo proceso)

# ---------------- Almacenamiento de objetos (MinIO local / R2 / S3) ----------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_local
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=contable-ia-documents
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin_local

# ---------------- Carga de documentos ----------------
UPLOAD_MAX_BYTES=20971520          # 20 MB por archivo (se valida además el tipo real por firma)
UPLOAD_MAX_FILES=20                # archivos por carga

# ---------------- Proveedores LLM ----------------
# Tope de gasto mensual configurado en cada proveedor (INSTRUCCIONES.md §3).
LLM_PROVIDER=anthropic             # proveedor principal
LLM_MODEL_EXTRACTION=
LLM_MODEL_JUDGE=
LLM_JUDGE_PROVIDER=                # proveedor del juez (distinto del extractor si se puede)
# La temperatura de extracción va fija en 0 en código, no es configurable.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=                    # segundo proveedor para comparar
LLM_MONTHLY_BUDGET_USD=40
LLM_DAILY_BUDGET_USD=2
LLM_MAX_COST_PER_DOC_USD=          # tope por documento; si se supera, se corta y se registra

# ---------------- Modelo propio (fase 4, vLLM compatible OpenAI) ----------------
VLLM_BASE_URL=
VLLM_API_KEY=
VLLM_MODEL=
HF_TOKEN=                          # Hugging Face (descarga/subida de modelos)
RUNPOD_API_KEY=                    # GPU para ajuste fino/vLLM (RunPod o Modal: uno de los dos)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ---------------- OCR ----------------
TESSERACT_CMD=                     # ruta al binario si no está en el PATH
OCR_LANG=spa

# ---------------- Embeddings y re-ranker (fase 2) ----------------
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIM=
RERANKER_MODEL=

# ---------------- Observabilidad ----------------
# Langfuse Cloud (o Phoenix local con: docker compose --profile observability up -d)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
PHOENIX_PORT=6006
PHOENIX_OTLP_GRPC_PORT=4317
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# ---------------- MLflow (fase 2) ----------------
MLFLOW_TRACKING_URI=
MLFLOW_S3_ENDPOINT_URL=http://127.0.0.1:9000
MLFLOW_ARTIFACT_BUCKET=contable-ia-mlflow
# Credenciales S3 que usa el cliente de MLflow para los artefactos (en local, las de MinIO).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------------- Anotación (Label Studio) ----------------
LABEL_STUDIO_URL=http://localhost:8080
LABEL_STUDIO_API_KEY=

# ---------------- Autenticación (Clerk o Auth.js) ----------------
AUTH_PROVIDER=                     # clerk | authjs
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=
AUTH_SECRET=
AUTH_URL=http://localhost:3000     # Auth.js

# ---------------- Web (Next.js) ----------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------- Servidor MCP (fase 3) ----------------
MCP_SERVER_PORT=8765

# ---------------- Anonimización (solo local) ----------------
# Clave para cifrar la tabla de correspondencias de ml/anonymize.py. Nunca fuera de la máquina local.
ANONYMIZATION_MAPPING_KEY=
